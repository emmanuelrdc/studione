# Studione - Variables de Entorno
# Copia este archivo a .env.local y configura los valores

# REQUERIDO: Clave secreta para firmar JWT tokens (mín. 32 caracteres aleatorios)
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Contraseña inicial del admin (se aplica solo en el primer arranque, si el usuario no existe)
INITIAL_ADMIN_PASSWORD=

# URL pública del sitio (sin trailing slash)
NEXT_PUBLIC_SITE_URL=https://studione.vercel.app

# Entorno de ejecución (development | production)
NODE_ENV=development

# Ruta del archivo SQLite en disco. Vacío = usa ./studione.db (raíz del proyecto).
# En Railway: apuntar dentro del Volume montado, ej. DB_PATH=/data/studione.db
# (si no, la base de datos se pierde en cada redeploy porque el filesystem no persiste).
DB_PATH=

# Carpeta donde se guardan las imágenes subidas por el cliente. Vacío = usa
# ./public/uploads (Next.js las sirve como estáticas). En Railway: apuntar dentro
# del Volume montado, ej. UPLOADS_DIR=/data/uploads (mismo motivo que DB_PATH).
# La URL pública (/uploads/archivo.jpg) sigue siendo la misma en ambos casos.
UPLOADS_DIR=

# OPCIONAL: SMTP para enviar emails desde el formulario de contacto
# Si no se configuran, los mensajes se guardan en la DB pero no se envían por email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=
